HOST_FOLDER="/full/path/to/this/folder"
INPUT_FOLDER="$HOST_FOLDER/input"
OUTPUT_FOLDER="$HOST_FOLDER/output"

IMAGE_NAME="ghcr.io/philiptn/mkv-auto"
CONTAINER_NAME="mkv-auto-service"

TEMP_FOLDER="$HOST_FOLDER/.tmp"
CONFIG_FOLDER="$HOST_FOLDER/config"
LOGS_FOLDER="$HOST_FOLDER/logs"

# Answer output-path lookups from a folder shared with the qBittorrent
# integration. Enable this when using LIVE_COPY over there. The queue lives
# inside the input folder (hidden from the pipeline), so it needs no extra mount.
RESOLVE_WORKER=false
RESOLVE_QUEUE_DIR="/mkv-auto/files/input/.mkv-auto-resolve"