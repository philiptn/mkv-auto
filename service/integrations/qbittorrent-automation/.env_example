QBITTORRENT_URL=http://127.0.0.1:8080
QBITTORRENT_USERNAME="username"
QBITTORRENT_PASSWORD="yourpassword"

# Map each tag to the MKV-Auto instance that should process it. Add as many
# instances as you like - this is the only place folders are configured.
#   input   where completed torrents are copied for processing (required)
#   output  that instance's output folder. Setting it enables sequential live
#           copy for this tag (see LIVE_COPY below), so the media appears in
#           your library while it is still downloading. Must never be an input
#           folder of any tag. Leave it out to skip live copy for that tag.
# Every folder listed here must be mounted 1:1 in docker-compose.yml.
TARGETS='{"mkv-auto": {"input": "/home/philip/mkv-auto-service/input", "output": "/home/philip/mkv-auto-service/output"}, "H.265": {"input": "/home/philip/mkv-auto-encoder/input", "output": "/home/philip/mkv-auto-encoder/output"}}'

DONE_TAG="✔"
FAILED_TAG="✘"
TRANSLATE_WINDOWS_PATHS=false
MAPPINGS_FILE=drive-mappings.txt

# Sequential live copy: download matched torrents sequentially and continuously
# copy the finished part of each media file to the MKV-Auto output folder, so it
# is watchable while it downloads. MKV-Auto overwrites it with the processed
# version when the torrent finishes.
# Applies to every TARGETS tag that has an "output" folder.
# Requires RESOLVE_WORKER=true in the MKV-Auto service's .env.
LIVE_COPY=false
# Turn on sequential download + first/last piece priority on matched torrents
LIVE_COPY_SET_SEQUENTIAL=true

# Where MKV-Auto answers output-path lookups. Empty means '.mkv-auto-resolve'
# inside each TARGETS folder, which needs no extra mount. Set this only if you
# gave the MKV-Auto service a custom RESOLVE_QUEUE_DIR.
LIVE_COPY_RESOLVE_DIR=
LIVE_COPY_RESOLVE_TIMEOUT=120

# Live copy tuning
LIVE_COPY_INTERVAL=10
LIVE_COPY_MAX_WORKERS=4
LIVE_COPY_MIN_SIZE_MB=200
LIVE_COPY_EXTENSIONS=.mkv,.mp4,.avi,.m4v,.ts,.mov,.wmv,.flv,.webm
LIVE_COPY_CHUNK_MB=8
LIVE_COPY_STALL_TIMEOUT=1800
